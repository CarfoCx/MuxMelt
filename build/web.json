{
  "extends": "build/base.json",
  "win": {
    "target": [
      {
        "target": "nsis-web",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.png"
  },
  "nsisWeb": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "perMachine": false,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "deleteAppDataOnUninstall": false,
    "shortcutName": "MuxMelt",
    "menuCategory": "MuxMelt",
    "runAfterFinish": true,
    "installerHeader": "build/installerHeader.bmp",
    "installerSidebar": "build/installerSidebar.bmp",
    "uninstallerSidebar": "build/installerSidebar.bmp",
    "appPackageUrl": "https://github.com/CarfoCx/MuxMelt/releases/latest/download",
    "artifactName": "MuxMelt-${version}-windows-${arch}-web-setup.${ext}"
  }
}
