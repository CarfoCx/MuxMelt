{
  "appId": "com.carfocx.muxmelt",
  "productName": "MuxMelt",
  "directories": {
    "output": "dist"
  },
  "files": [
    "main.js",
    "preload.js",
    "setup-preload.js",
    "package.json",
    "LICENSE",
    "README.md",
    "PRIVACY.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "build/icon.png",
    "src/**/*",
    "renderer/**/*",
    "node-tools/**/*",
    "python/**/*",
    "!python/weights/**",
    "!python/**/__pycache__/**",
    "!**/*.pyc"
  ],
  "asarUnpack": [
    "node_modules/sharp/**",
    "node_modules/@img/**",
    "python/**"
  ],
  "extraResources": [
    {
      "from": "build/bundle/python-env",
      "to": "python-env",
      "filter": ["**/*"]
    },
    {
      "from": "build/bundle/ffmpeg",
      "to": "ffmpeg",
      "filter": ["**/*"]
    }
  ]
}
